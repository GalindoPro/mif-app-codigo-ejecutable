# Configuración de Producción - MIF Cooperativa
# Copie este archivo como .env en el servidor: cp .env.production.example .env

# 1. Base de Datos PostgreSQL
POSTGRES_DB=mif_prod
POSTGRES_USER=mif_admin
# Genere una contraseña segura (ej. openssl rand -base64 24)
POSTGRES_PASSWORD=contrasena_robusta_para_la_cooperativa_2026

# 2. Seguridad JWT para Sesiones
# Genere una clave de 64 caracteres (ej. openssl rand -hex 32)
JWT_SECRET=clave_secreta_super_segura_de_produccion_mif_64_caracteres_random
JWT_EXPIRES_IN=8h

# 3. Zona Horaria Oficial
TZ=America/Guatemala
